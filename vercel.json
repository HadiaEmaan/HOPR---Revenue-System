{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "index.html",
        "styles.css",
        "secure-app.js",
        "hopr.jpeg",
        "gymkhana.png",
        "invoice.png",
        "clinic.jpeg",
        "Patient History & Assessment Form.pdf"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__pms_path=/api/:path*"
    }
  ]
}
